# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
DEBUG=true

# Database
# For MySQL (Recommended): mysql+pymysql://<user>:<password>@<host>:<port>/<dbname>?charset=utf8mb4
# For SQLite (Local dev): sqlite:///./misson.db
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/misson_db?charset=utf8mb4

# JWT
JWT_SECRET_KEY=change-this-to-a-secure-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Claude API
CLAUDE_API_KEY=your-claude-api-key-here
CLAUDE_MODEL=claude-sonnet-4-20250514
CLAUDE_MAX_TOKENS=4096

# Upload
MAX_UPLOAD_SIZE_MB=20
UPLOAD_DIR=./uploads

# Demo Mode
DEMO_MODE=true

# Rate Limiting
RATE_LIMIT_PER_MINUTE=30
GENERATION_LIMIT_FREE=3
